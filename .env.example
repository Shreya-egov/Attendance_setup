# Copy to .env and fill in. .env is git-ignored - never commit it.
# Optional settings (locale, boundary code, register level, timeouts, token
# login) are listed in the README under "Optional settings".

# ---- environment -------------------------------------------------------
HCM_BASE_URL=https://unified-qa.digit.org
HCM_TENANT_ID=qa

# ---- login -------------------------------------------------------------
# Needs CAMPAIGN_MANAGER plus an attendance write role (e.g. DISTRICT_SUPERVISOR).
HCM_USERNAME=
HCM_PASSWORD=
# Static OAuth client credential, base64 of "egov-user-client:" - the same
# Basic header the DIGIT UI sends. Not a secret of the user account.
HCM_BASIC_AUTH=ZWdvdi11c2VyLWNsaWVudDo=

# ---- campaigns ---------------------------------------------------------
# One campaign per type when --type is omitted.
HCM_CAMPAIGN_TYPES=BEDNET,MR-DN
HCM_HIERARCHY_TYPE=NIGERIA
# Copy this campaign's boundary selection (./list_boundaries.py to explore).
HCM_BOUNDARIES_FROM=CMP-2026-10-06-011022

# ---- users (one per role, sequential phone numbers) ---------------------
HCM_USER_ROLES=DISTRIBUTOR,FIELD_SUPPORT,TEAM_SUPERVISOR,PAYMENT_EDITOR,PAYMENT_REVIEWER,PAYMENT_APPROVER,PROXIMITY_SUPERVISOR,CAMPAIGN_SUPERVISOR
# Boundary level the users are created at.
HCM_USER_LEVEL=DISTRICT

# ---- payment -----------------------------------------------------------
# Billing code: WEEKLY, BI_WEEKLY, MONTHLY or CUSTOM (CUSTOM needs the days).
HCM_BILLING=CUSTOM
HCM_BILLING_DAYS=3
# food,travel,per-day wage for every wage role
HCM_RATES=50,50,150
