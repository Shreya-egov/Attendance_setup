# Copy to .env and fill in. .env is git-ignored - never commit it.
# The scripts read .env from this folder themselves; real environment
# variables override anything set here.

# ---- environment -------------------------------------------------------
HCM_BASE_URL=https://unified-qa.digit.org
HCM_TENANT_ID=qa
# demo instead:
# HCM_BASE_URL=https://health-demo.digit.org
# HCM_TENANT_ID=demo

# ---- auth: EITHER a token ... ------------------------------------------
# An access token you already have (e.g. from the browser session). Takes
# precedence over the password login below when set.
# HCM_AUTH_TOKEN=

# ---- ... OR the password login (POST /user/oauth/token) ----------------
HCM_USERNAME=
HCM_PASSWORD=
# Static OAuth client credential, base64 of "egov-user-client:" - the same
# Basic header the DIGIT UI sends. Not a secret of the user account.
HCM_BASIC_AUTH=ZWdvdi11c2VyLWNsaWVudDo=

# Roles the account needs:
#   registers + user mapping  DISTRICT_SUPERVISOR (or PROVINCIAL/NATIONAL_SUPERVISOR,
#                             SUPERUSER, SYSTEM_ADMINISTRATOR)
#   payment setup (--billing) CAMPAIGN_MANAGER

# ---- the campaign to work on -------------------------------------------
# Used when no campaign number is given on the command line; a number typed
# on the command line always wins. The scripts print which one they use.
HCM_CAMPAIGN_NUMBER=

# ---- e2e.py / create_campaign.py: new campaigns ------------------------
# Campaign types e2e.py creates (one campaign each when --type is omitted).
HCM_CAMPAIGN_TYPES=BEDNET,MR-DN
HCM_HIERARCHY_TYPE=NIGERIA
# Copy an existing campaign's boundary selection (or HCM_BOUNDARY=<code>:
# root -> code with all its children). Facilities/users are mapped there.
HCM_BOUNDARIES_FROM=CMP-2026-10-06-011022
# HCM_BOUNDARY=
# One user is created per role, at the campaign's boundary.
HCM_USER_ROLES=DISTRIBUTOR,FIELD_SUPPORT,TEAM_SUPERVISOR,PAYMENT_EDITOR,PAYMENT_REVIEWER,PAYMENT_APPROVER,PROXIMITY_SUPERVISOR,CAMPAIGN_SUPERVISOR
# First phone number; later ones go up by one, tracked in issued_users.json.
HCM_USER_PHONE_START=9100000001
# Optional: default templates/<TYPE>_sample.xlsx
# HCM_SAMPLE_TEMPLATE=
# HCM_LOCALE=

# ---- payment setup (setup_attendance.py / setup_payment.py) -------------
# Set HCM_BILLING to make setup_attendance.py also do the payment step;
# leave empty to skip it (or pass --skip-payment).
# Billing codes: WEEKLY, BI_WEEKLY, MONTHLY, CUSTOM (CUSTOM needs the days).
HCM_BILLING=CUSTOM
HCM_BILLING_DAYS=3
# food,travel,per-day wage for every role, e.g. 50,50,150
HCM_RATES=50,50,150

# ---- optional defaults -------------------------------------------------
# Register level: auto = where the DISTRIBUTOR users are mapped (default),
# or a 1-based level (3 = DISTRICT in NIGERIA), a type name, or leaf.
# HCM_REGISTER_LEVEL=auto
# Role whose boundaries --level auto follows.
# HCM_AUTO_LEVEL_ROLE=DISTRIBUTOR
